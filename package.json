{
  "name": "csph-forms",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "test": "npm run test:db && npm run test:seed && npm run test:auth && npm run test:forms && npm run test:publication && npm run test:responses && npm run test:owned-responses && npm run test:export && npm run test:webhooks && npm run test:consumer && npm run test:network --workspace @forms/web",
    "dev": "concurrently --kill-others --names api,web,consumer \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:consumer\"",
    "dev:api": "npm run dev --workspace @forms/api",
    "dev:web": "npm run dev --workspace @forms/web",
    "dev:consumer": "npm run dev --workspace @forms/webhook-consumer",
    "build": "npm run build --workspaces",
    "test:db": "npm run test:db --workspace @forms/api",
    "seed": "npm run seed --workspace @forms/api",
    "test:seed": "npm run test:seed --workspace @forms/api",
    "test:auth": "npm run test:auth --workspace @forms/api",
    "test:forms": "npm run test:forms --workspace @forms/api",
    "test:publication": "npm run test:publication --workspace @forms/api",
    "test:responses": "npm run test:responses --workspace @forms/api",
    "test:owned-responses": "npm run test:owned-responses --workspace @forms/api",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint apps",
    "format:check": "prettier --check package.json tsconfig.base.json eslint.config.mjs apps",
    "format": "prettier --write package.json tsconfig.base.json eslint.config.mjs apps",
    "test:export": "npm run test:export --workspace @forms/api",
    "test:webhooks": "npm run test:webhooks --workspace @forms/api",
    "test:consumer": "npm run test --workspace @forms/webhook-consumer"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "concurrently": "^9.2.0",
    "eslint": "10.12.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "dependencies": {
    "dotenv": "^18.0.6",
    "pg": "^8.23.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
