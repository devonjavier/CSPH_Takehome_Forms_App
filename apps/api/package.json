{
  "name": "@forms/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test:db": "node --env-file-if-exists=../../.env --import tsx --test test/database.test.ts",
    "seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "test:seed": "node --env-file-if-exists=.env --import tsx --test test/seed.test.ts"
  },
  "dependencies": {
    "express": "5.2.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/pg": "^8.23.1"
  }
}
