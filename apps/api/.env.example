PORT=4000
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=forms_dev
PGDATABASE=forms_app
# Match POSTGRES_PASSWORD in your local root .env; never expose it to Next.js.
PGPASSWORD=local_dev_change_me
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
WEB_ORIGIN=http://localhost:3000
# Optional locally; required with NODE_ENV=production. Exact comma-separated
# trusted receiver origins (no paths), e.g. https://receiver.example.com.
WEBHOOK_ALLOWED_ORIGINS=
